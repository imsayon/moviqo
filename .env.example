# ============================================================
# MOVIQO - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - it's in .gitignore
# ============================================================

# ============================================================
# FIREBASE CLIENT SDK CONFIGURATION (Safe - Public)
# ============================================================
# Get these from Firebase Console > Project Settings
# These are public and safe to expose in frontend code

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# ============================================================
# FIREBASE ADMIN SDK CONFIGURATION (Sensitive - Private!)
# ============================================================
# Get these from Firebase Console > Project Settings > Service Accounts
# KEEP THESE SECRET - Never share or commit to Git!
# These allow full access to your Firebase project

FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_PRIVATE_KEY_ID=key_id_from_json_file_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id_here
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================

# Node.js environment (development, production, test)
NODE_ENV=development

# Backend server port
PORT=5000

# Frontend API URL (used by client to call backend)
VITE_API_URL=http://localhost:5000/api

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Comma-separated list of allowed origins for API requests
# Update for production domains

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# ============================================================
# LOGGING & DEBUG
# ============================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=debug

# Enable verbose logging in development
DEBUG=moviqo:*

# ============================================================
# SECURITY
# ============================================================

# Session timeout in minutes
SESSION_TIMEOUT=60

# Maximum requests per minute (rate limiting)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================================
# FIREBASE SERVICES CONFIGURATION
# ============================================================

# Firestore emulator (for local development)
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Auth emulator (for local development)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Database emulator (if using Realtime Database)
# FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000

# ============================================================
# OPTIONAL: THIRD-PARTY SERVICES
# ============================================================

# Sentry error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# Analytics tracking ID (optional)
# GA_ID=your_google_analytics_id

# Email service for notifications (optional)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# ============================================================
# INSTRUCTIONS FOR SETUP
# ============================================================
#
# 1. Create Firebase Project:
#    - Go to https://console.firebase.google.com
#    - Click "Create Project"
#    - Enter project name, region
#
# 2. Get Client Config:
#    - Firebase Console > Project Settings (gear icon)
#    - Scroll down to "Your apps"
#    - Click "Web" app
#    - Copy config values
#
# 3. Get Admin SDK Config:
#    - Firebase Console > Project Settings > Service Accounts
#    - Click "Generate New Private Key"
#    - Download JSON file
#    - Extract values for FIREBASE_* variables
#
# 4. Enable Services:
#    - Authentication: Enable Google sign-in provider
#    - Firestore: Create database in production mode
#    - Hosting: Initialize via Firebase CLI
#
# 5. Set Environment Variables:
#    - Copy this file to .env
#    - Fill in actual values from Firebase
#    - Keep .env file secret and secure
#
# 6. Deploy:
#    - firebase deploy
#
# ============================================================

