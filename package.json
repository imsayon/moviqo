{
  "name": "moviqo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "concurrently -k -n server,client -c red,cyan \"pnpm --dir server dev\" \"pnpm --dir client dev\"",
    "dev:server": "pnpm --dir server dev",
    "dev:client": "pnpm --dir client dev",
    "build": "pnpm --dir client build",
    "start": "pnpm build && pnpm --dir server start",
    "lint": "pnpm --dir client lint",
    "clean": "rm -rf client/dist client/node_modules/.vite"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
