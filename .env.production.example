# ============================================================
# MOVIQO - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Use this template for production deployment
# Copy to .env and fill with actual production values
# Deploy to Firebase Cloud Functions or use in firebase.json
# ============================================================

# ============================================================
# FIREBASE CLIENT SDK - PRODUCTION
# ============================================================
# Same as development, but ensure it's your production project

VITE_FIREBASE_API_KEY=your_production_api_key
VITE_FIREBASE_AUTH_DOMAIN=moviqo-production.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=moviqo-production
VITE_FIREBASE_STORAGE_BUCKET=moviqo-production.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_production_sender_id
VITE_FIREBASE_APP_ID=your_production_app_id

# ============================================================
# FIREBASE ADMIN SDK - PRODUCTION
# ============================================================
# Use your production service account credentials
# Keep these EXTREMELY secret!

FIREBASE_PROJECT_ID=moviqo-production
FIREBASE_PRIVATE_KEY_ID=production_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@moviqo-production.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=production_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ============================================================
# APPLICATION - PRODUCTION
# ============================================================

# Must be production
NODE_ENV=production

# Production port (Firebase Cloud Functions)
PORT=8080

# Production API URL
# Use your Firebase Hosting domain
VITE_API_URL=https://moviqo-production.firebaseapp.com/api

# ============================================================
# CORS - PRODUCTION DOMAINS
# ============================================================
# Only allow requests from your production domain(s)

ALLOWED_ORIGINS=https://moviqo-production.firebaseapp.com,https://your-custom-domain.com

# ============================================================
# SECURITY - PRODUCTION
# ============================================================

# Increase session timeout for production
SESSION_TIMEOUT=120

# Stricter rate limiting in production
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=60

# ============================================================
# MONITORING & LOGGING - PRODUCTION
# ============================================================

LOG_LEVEL=warn

# Sentry for error tracking (recommended)
SENTRY_DSN=your_sentry_dsn_for_production

# Google Analytics (optional)
GA_ID=your_ga_id_for_production

# ============================================================
# DATABASE - PRODUCTION
# ============================================================

# Firestore backups enabled
FIRESTORE_BACKUPS_ENABLED=true
FIRESTORE_BACKUP_LOCATION=us-multi-region

# Data retention policy
DATA_RETENTION_DAYS=365

# ============================================================
# CERTIFICATES & SECURITY
# ============================================================

# SSL/TLS (handled by Firebase Hosting - always HTTPS)
# HTTPS is enforced automatically

# JWT settings
JWT_EXPIRY=3600

# CSRF protection
CSRF_ENABLED=true

# ============================================================
# DEPLOYMENT NOTES
# ============================================================
#
# 1. Create separate Firebase project for production
#    - Use naming convention: moviqo-production
#    - Enable all services (Auth, Firestore, Hosting)
#
# 2. Configure OAuth URLs
#    - Add production domain to Google Cloud Console
#    - Update Firebase Authentication settings
#
# 3. Set environment variables
#    - On Firebase Cloud Functions: firebase functions:config:set env.* value
#    - On Vercel/Cloud Run: Set via platform UI
#    - Locally: Create .env with this template
#
# 4. Database setup
#    - Create new Firestore database
#    - Deploy security rules: firebase deploy --only firestore:rules
#    - Enable backup scheduling
#
# 5. Enable monitoring
#    - Set up Sentry for error tracking
#    - Enable Firebase Analytics
#    - Configure Cloud Logging
#
# 6. Security checklist
#    - [ ] HTTPS enforced (Firebase default)
#    - [ ] Security rules deployed
#    - [ ] CORS configured for production domains
#    - [ ] Sensitive data in environment variables
#    - [ ] API rate limiting enabled
#    - [ ] Database backups enabled
#    - [ ] Monitoring and alerts set up
#    - [ ] No hardcoded secrets in code
#
# 7. Performance optimization
#    - [ ] CDN enabled (Firebase Hosting)
#    - [ ] Cache headers configured
#    - [ ] Assets optimized
#    - [ ] Database indexes created
#
# ============================================================
